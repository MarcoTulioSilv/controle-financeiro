{
    "compilerOptions":{
        "target": "ES2023",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "rootDir": "src",
        "outDir": "dist",
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "sourceMap": true,
        "skipLibCheck": true
    },
    "include":["src"],
    "exclude":["src/**/*.test.ts"]
}