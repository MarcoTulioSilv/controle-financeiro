# Modelo das variáveis de ambiente.
# Copie para ".env" e preencha os valores. O arquivo .env NUNCA é versionado.
# Gere senhas e tokens longos e aleatórios (veja o README).

# ----- Banco de dados (MySQL) -----
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=financeiro
MYSQL_USER=financeiro_app
MYSQL_PASSWORD=

# ----- Token do gateway (ADR-002: permissão mínima) -----
GATEWAY_TOKEN=

# ----- Fuso horário (RN04) -----
TZ=America/Sao_Paulo
